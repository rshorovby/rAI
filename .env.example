TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
# Лучшая модель для всех пользователей (тариф режет только квоты, не качество).
GEMINI_MODEL_PRO=gemini-3.1-pro-preview
# Устарело: больше не маршрутизируется для обычного разбора. Оставлено для совместимости.
# GEMINI_MODEL_FREE используется как запасная модель при перегрузке (кнопка «Разобрать проще»).
# GEMINI_MODEL_FREE=gemini-3.5-flash
# Telegram user_id админов через запятую (/stats, /grant). Узнать id: @userinfobot
ADMIN_USER_IDS=
# Кабинет тренера (Product V2): супергруппа с Topics + user_id тренеров
# COACH_FORUM_CHAT_ID=-100xxxxxxxxxx
# COACH_USER_IDS=123456789
# Опционально: Sentry DSN для продакшен-ошибок
SENTRY_DSN=
