TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
# Монетизация (paywall / Pro / Stars). По умолчанию выкл. — открытая бета для всех.
# MONETIZATION_ENABLED=1
# Лучшая модель для всех пользователей (тариф режет только квоты, не качество).
GEMINI_MODEL_PRO=gemini-3.1-pro-preview
# Устарело: больше не маршрутизируется для обычного разбора. Оставлено для совместимости.
# GEMINI_MODEL_FREE используется как запасная модель при перегрузке (кнопка «Разобрать проще»).
# GEMINI_MODEL_FREE=gemini-3.5-flash
# Telegram user_id админов через запятую (/stats, /grant). Узнать id: @userinfobot
ADMIN_USER_IDS=
# Кабинет тренера (Product V2): супергруппа с Topics + user_id тренеров
# COACH_FORUM_CHAT_ID=-100xxxxxxxxxx
# COACH_USER_IDS=123456789
# HTTP канала iOS (тот же процесс, nginx снаружи). Пусто = только бот.
# HTTP_HOST=127.0.0.1
# HTTP_PORT=8080
# APPLE_BUNDLE_ID=com.rakets.rallymind
# Опционально: Sentry DSN для продакшен-ошибок
SENTRY_DSN=
# Новый разбор: промпт v2 и JSON по схеме. По умолчанию выкл. Только язык ru.
# При включении видео всегда идёт на 8 кадрах/с, в высоком разрешении, температура 0.3.
# Thinking не задаётся. Старый путь (флаг выкл или язык не ru) это не использует.
# STRUCTURED_ANALYSIS_V2=1
# FOCUS_EVIDENCE_REQUIRED=1
