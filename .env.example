TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
# Монетизация (paywall / Pro / Stars). По умолчанию выкл. — открытая бета для всех.
# MONETIZATION_ENABLED=1
# Основная модель видеоразбора (Gemini 4 Neon, thinking_level=low).
GEMINI_MODEL_PRO=gemini-4-neon
# Запасная модель при 503-перегрузке и дефолт для будущего Free-тарифа (thinking_level=medium).
GEMINI_MODEL_FREE=gemini-4-hydrogen
# Модель для последующего диалога по отчёту (thinking_level=low).
# GEMINI_MODEL_CHAT=gemini-4-hydrogen
# Уровни thinking для Gemini 4 (low / medium / high / xhigh).
# GEMINI_THINKING_PRO=low
# GEMINI_THINKING_FREE=medium
# GEMINI_THINKING_CHAT=low
# Service tier Gemini API: standard (по умолчанию) или flex (−50% цены, задержка 1–15 мин).
# GEMINI_SERVICE_TIER=standard
# Компактный персонализированный промпт в STRUCTURED_ANALYSIS_V2 (по умолчанию включён; 0 откатывает).
# COMPACT_PROMPT_V3=1
# Telegram user_id админов через запятую (/stats, /grant). Узнать id: @userinfobot
ADMIN_USER_IDS=
# Кабинет тренера (Product V2): супергруппа с Topics + user_id тренеров
# COACH_FORUM_CHAT_ID=-100xxxxxxxxxx
# COACH_USER_IDS=123456789
# HTTP канала iOS (тот же процесс, nginx снаружи). Пусто = только бот.
# HTTP_HOST=127.0.0.1
# HTTP_PORT=8080
# APPLE_BUNDLE_ID=app.advantace.ios
# Опционально: Sentry DSN для продакшен-ошибок
SENTRY_DSN=
# Новый разбор: промпт v2 и JSON по схеме. По умолчанию выкл. Только язык ru.
# При включении видео всегда идёт на 8 кадрах/с, в высоком разрешении, температура 0.3.
# Thinking не задаётся. Старый путь (флаг выкл или язык не ru) это не использует.
# STRUCTURED_ANALYSIS_V2=1
# Чеклист наблюдения форхенда в системном промпте. По умолчанию включён.
# Формат отчёта не меняет. FOREHAND_CHECKLIST=0 выключает.
# FOREHAND_CHECKLIST=0
# Чеклист наблюдения бэкхенда в системном промпте. По умолчанию включён.
# Формат отчёта не меняет. BACKHAND_CHECKLIST=0 выключает. Slice сюда не входит.
# BACKHAND_CHECKLIST=0
# Чеклист резаного удара в системном промпте. По умолчанию включён.
# Формат отчёта не меняет. SLICE_CHECKLIST=0 выключает.
# SLICE_CHECKLIST=0
# Чеклист подачи в системном промпте. По умолчанию включён.
# Формат отчёта не меняет. SERVE_CHECKLIST=0 выключает.
# SERVE_CHECKLIST=0
# FOCUS_EVIDENCE_REQUIRED=1
